# Next.js listen port on the VPS (nginx proxies here — never use 3000)
WEB_PORT=3847

# Browser: same-origin API proxy. Do not use this for server-side fetches.
NEXT_PUBLIC_API_URL=/api
# Server (SSR + API proxy): absolute URL to the Express API.
# Local Express default is 4000. On the VPS use 4871.
API_URL=http://127.0.0.1:4000/api
